{
  "name": "ligapedia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:deploy": "pnpm --filter @ligapedia/web --filter @ligapedia/api --filter @ligapedia/ingest build",
    "start": "node apps/api/dist/server.js",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "size": "pnpm --filter @ligapedia/web build && pnpm --filter @ligapedia/web size",
    "test:e2e": "pnpm --filter @ligapedia/web test:e2e",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm size"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ligapedia/db": "workspace:*",
    "@ligapedia/domain": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.9",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
