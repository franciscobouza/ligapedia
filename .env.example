# Database connections (local dev values match docker-compose.dev.yml).
# A single DATABASE_URL can replace both (used on Coolify/Railpack).
DATABASE_URL_INGEST=postgres://ligapedia_ingest:ingest@127.0.0.1:54329/ligapedia
DATABASE_URL_API=postgres://ligapedia_api:api@127.0.0.1:54329/ligapedia

# Contact shown in the crawler User-Agent and on "Sobre los datos"
LIGAPEDIA_CONTACT=contacto@example.com
# Public domain served by Caddy (production)
LIGAPEDIA_DOMAIN=localhost
# Maximum concurrent requests to the league's site
INGEST_CONCURRENCY=4
